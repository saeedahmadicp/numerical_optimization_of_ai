    given-names: "Saeed"
  - family-names: "Ali"
    given-names: "Izhar"
version: 1.0.0
license: MIT
repository-code: "https://github.com/saeedahmadicp/numopt"
url: "https://saeedahmadicp.github.io/numopt/"
keywords:
